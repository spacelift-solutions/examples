<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Terraform + Ansible Spacelift workflow</title>
    <style>
      img {
        display: block;
        max-width: 100%;
      }
    </style>
  </head>
  <body>
    <h1>Terraform + Ansible Spacelift workflow</h1>

    <p>This server is running on {{ ansible_facts['default_ipv4']['address'] }}:{{ port_number }}.</p>

    <p>
      Created by
      <a href="https://{{ lookup('env', 'TF_VAR_spacelift_account_name') }}.app.spacelift.io/stack/{{ lookup('env', 'TF_VAR_spacelift_stack_id') }}/run/{{ lookup('env', 'TF_VAR_spacelift_run_id') }}">https://{{ lookup('env', 'TF_VAR_spacelift_account_name') }}.app.spacelift.io/stack/{{ lookup('env', 'TF_VAR_spacelift_stack_id') }}/run/{{ lookup('env', 'TF_VAR_spacelift_run_id') }}</a>
    </p>

    <p>
      <img alt="Hello from Ansible" src="https://cataas.com/cat/says/Hello%20from%20Spacelift" />
    </p>
  </body>
</html>
